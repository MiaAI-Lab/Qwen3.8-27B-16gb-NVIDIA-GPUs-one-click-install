diff --git a/setup.py b/setup.py
index ae33064..1c7298d 100644
--- a/setup.py
+++ b/setup.py
@@ -62,6 +62,26 @@ sources = [
     if file.endswith(('.c', '.cpp', '.cu'))
 ]
 
+# aarch64 port: these sources use x86-only intrinsics (__builtin_cpu_supports,
+# __builtin_ia32_pause, immintrin.h) and cannot build on ARM (e.g. DGX Spark /
+# GB10). They implement CPU GEMV/expert-offload and the x86 CPU tensor-parallel
+# all-reduce; neither is used when inference runs on the GPU.
+_X86_ONLY_SOURCES = [
+    "avx2_target.cpp",
+    "avx512_target.cpp",
+    "cpu/moe_handoff.cu",
+    "cpu/moe_mul1.cpp",
+    "parallel/all_reduce_cpu_avx2.cpp",
+    "parallel/all_reduce_cpu_avx512.cpp",
+    "parallel/all_reduce_cpu.cu",
+]
+if getattr(os.uname(), "machine", "x86_64") not in ("x86_64", "AMD64"):
+    sources = [
+        s_ for s_ in sources
+        if os.path.relpath(s_, sources_dir).replace(os.sep, "/") not in _X86_ONLY_SOURCES
+    ]
+    print(" !! aarch64 build: excluded %d x86-only CPU sources" % len(_X86_ONLY_SOURCES))
+
 print (sources)
 
 setup_kwargs = (
