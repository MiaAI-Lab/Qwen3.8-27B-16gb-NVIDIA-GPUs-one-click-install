+    base = tok * n_kv_heads + kv_head                                    # [BLOCK_N]
+    offs_b = tl.arange(0, hd2)
+    b = tl.load(k4 + base[:, None] * hd2 + offs_b[None, :],
+                mask = mask_n[:, None], other = 0)                       # [BLOCK_N, hd2]
+    lo = (b & 15).to(tl.int32)
+    hi = (b >> 4).to(tl.int32)
+    offs_s = tl.arange(0, hds)
