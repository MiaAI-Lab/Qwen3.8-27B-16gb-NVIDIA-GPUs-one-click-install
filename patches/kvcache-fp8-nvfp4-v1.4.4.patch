+@triton.jit
+def _nvfp4_kt_tile(k4, ks, phys, page_off, mask_n, kv_head,
+                   n_kv_heads: tl.constexpr, page_size: tl.constexpr,
+                   head_dim: tl.constexpr, BLOCK_N: tl.constexpr):
