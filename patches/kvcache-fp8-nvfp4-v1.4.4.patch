+@triton.jit
+def _nvfp4_encode(x, s16):
+    """fp16 values x [..., head_dim] with per-16 fp16 scales s16 -> packed uint8 bytes [head_dim//2].
+    Mirrors cache.nvfp4.nvfp4_quantize bit-for-bit: fp32 math rounded to fp16 at each torch step,
