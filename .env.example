# ============================================================
#  exllamav3 OpenAI-compatible server — configuration
#  (read by ./start.sh and start.bat; restart the server after changes)
# ============================================================

# --- engine install (first run only) ---------------------------
# On first launch start.sh creates .venv and installs the engine:
# inside the engine repo it builds from the local checkout; anywhere
# else (deployment kit) it pip-installs from EXL3_REPO.
# Default = official turboderp exllamav3 pinned to the v1.4.4 tag. PyPI has no
# 1.4.4 wheel (it jumps 1.4.2 -> 1.4.5), so the git tag is the only way to get
# exactly v1.4.4, which this quant needs (quantized vision tower).
# EXL3_REPO overrides (git+https://… URL or a path that exists on THIS machine).
# Do not copy a Linux/Spark path onto Windows — leave this commented.
# EXL3_REPO=git+https://github.com/turboderp-org/exllamav3.git@v1.4.4
# TORCH_INDEX_URL overrides the PyTorch wheel index for the GPU torch
# binary (x86 works with the default; GB10/Spark uses cu130).
# TORCH_CUDA_ARCH_LIST pins the extension build arch (GB10: "12.0;12.1";
# x86 auto-detects from the GPU and needs nothing).
# EXL3_REPO=git+https://github.com/turboderp-org/exllamav3.git@v1.4.4
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# TORCH_CUDA_ARCH_LIST=12.0;12.1

# --- profile (GPU-aware) --------------------------------------
# On the first start (no PROFILE line) or with PROFILE=ask, start.bat / start.sh
# read the GPU's VRAM and offer profiles - best quality vs longest context -
# e.g. 16 GB: 3.0 bpw @ 147k, 2.5 bpw @ 229k, 2.0 bpw @ 262k+images;
# 24 GB: 5.0 bpw @ 245k or 4.0 bpw @ 262k; 32 GB: 6.0 bpw @ 262k. The KV cache
# is always int4 for profiles (measured ~free in quality; any supported GPU).
# The choice is written below (MODEL_DIR, HF_*, CONTEXT_SIZE, CACHE_QUANT,
# GPU_MEM_GB, VISION, MODEL_ID). Re-pick any time:  start.bat profile
# PROFILE=ask

# --- models -------------------------------------------------
# Target model directory (EXL3 quant). Relative to this directory,
# or an absolute path. Downloaded from the Hub automatically if missing.
MODEL_DIR=models/Qwen3.8-27B-EXL3-2.0bpw
# Model id reported by /v1/models (default: the MODEL_DIR folder name, lower-cased).
# MODEL_ID=qwen3.8-27b-exl3-2.0bpw

# --- Speculative decoding ------------------------------------
# DRAFT selects the drafting method:
#   mtp     - MTP head inside the main checkpoint (~50 MB): no download.
#             Default, and what the 16 GB recipe was measured with.
#   none    - no drafting: slower per token, slightly less memory.
# DRAFT=mtp

# --- Hub downloads -------------------------------------------
# Missing MODEL_DIR is fetched automatically on start.
# Set HF_TOKEN=<a token with read access> here, or run `hf auth login`
# once. Override the repo id to use a mirror of your own.
# HF_TOKEN=hf_xxx
# HF_TARGET_REPO=Mia-AiLab/Qwen3.8-27B-EXL3-2.0bpw
# HF_REVISION picks a branch/tag of that repo (e.g. turboderp's 3.00bpw branch);
# pair it with a fresh MODEL_DIR so the 2.0 bpw weights are not overwritten.
# HF_TARGET_REPO=turboderp/Qwen3.8-27B-exl3
# HF_REVISION=3.00bpw
# MODEL_DIR=models/Qwen3.8-27B-EXL3-3.0bpw

# --- HTTP ----------------------------------------------------
PORT=8888
# Bind address. 0.0.0.0 = LAN-wide (no auth!), 127.0.0.1 = local only.
HOST=0.0.0.0

# --- chat UI (built in) --------------------------------------
# The server serves its own chat app at http://127.0.0.1:PORT/ - streaming,
# folded thinking, Markdown, image attachments, tool calls, and two modes:
#   Chat    the model plus web_search / web_fetch (read-only, no filesystem)
#   Agent   the same plus a workspace-scoped toolbox: list/read/find/search,
#           write_file, edit_file, run_python, run_command. Writes and
#           execution ask you in the browser before they run.
#   browser - serve it and open it once the server is Ready (default)
#   server  - serve it, open nothing (you open the URL yourself)
#   no      - do not serve it at all; /v1 still works for other clients
UI=browser
# The UI answers only this computer by default. HOST=0.0.0.0 exposes /v1 to
# your network, which is a different risk from exposing a UI whose Agent mode
# writes files and runs commands here - and there is no login. Set UI_LAN=1
# only if you trust every device on the network (a phone on the sofa is fine;
# a cafe wifi is not).
UI_LAN=0
# Host names the UI answers to besides localhost, comma separated. This is the
# safe way to reach it from outside: run the server on 127.0.0.1 and put a
# proxy in front (Tailscale Serve, or your own reverse proxy). The proxy
# connects from loopback, so the "only this computer" rule still holds and only
# the *name* has to be trusted - unlike UI_LAN=1, which lets any machine that
# can reach the port drive Agent mode.
#   tailscale serve --bg 8888      then     UI_HOSTS=yourbox.tailXXXX.ts.net
# UI_HOSTS=
# Name shown in the UI.
# UI_TITLE=Simplex
# Which folder picker the Agent's workspace chip opens:
#   native  - the system dialog (Windows FolderBrowserDialog, tkinter elsewhere).
#             It opens on THIS computer's screen, so the UI only offers it to
#             the machine the server runs on; other devices get the built-in
#             browser, as does any machine without a usable dialog.  (default)
#   browser - always the kit's own folder browser.
FOLDER_PICKER=native
# Folder the Agent mode may touch. Everything outside it is refused. Pick
# another one per chat in the UI (Workspace -> Change).
# AGENT_WORKSPACE=C:\Users\you\Documents\agent
# Tool switches:
#   WEB_TOOLS     1 = web_search + web_fetch in both modes (0 = model only)
#   AGENT_EXEC    1 = run_python / run_command exist in Agent mode. Set 0 to
#                 keep the agent to reading and editing files.
#   AGENT_ASK     1 = the agent may ask you a question mid-task (ask_user),
#                 rendered as buttons in the browser.
#   AGENT_MAX_STEPS  how many model->tool->model rounds one turn may take.
WEB_TOOLS=1
AGENT_EXEC=1
AGENT_ASK=1
AGENT_MAX_STEPS=8
# Timeouts for the two things that wait on you (seconds). A turn now also
# stops waiting as soon as you press Stop.
# APPROVAL_TIMEOUT=900
# QUESTION_TIMEOUT=1800
# How many results web_search asks for.
# SEARCH_RESULTS=6
# web_fetch refuses private, loopback and link-local addresses, so the model
# cannot reach this machine's own services or your LAN. Set 1 only if you want
# it reading an intranet page.
# WEB_FETCH_PRIVATE=0
# Key the UI sends to the model server (this kit ignores it).
# API_KEY=local

# Web search backend. Keyless DuckDuckGo by default (scraped, so it can break
# without warning). For something stable, point at your own SearXNG or add a
# Tavily key; either one wins over DuckDuckGo when set.
# SEARCH_PROVIDER=auto
# SEARXNG_URL=http://127.0.0.1:8080
# TAVILY_API_KEY=
# Sampling defaults the UI starts with (each chat can override them).
# TEMPERATURE=0.6
# TOP_P=0.95
# TOP_K=20
# MAX_TOKENS=4096

# --- chat app: Cherry Studio (Windows, start.bat only) --------
# Cherry Studio is an open-source desktop chat app (streaming, tools, MCP):
# https://github.com/CherryHQ/cherry-studio . start.bat downloads the pinned
# Windows portable build once into apps/cherry-studio/ (~285 MB, gitignored),
# writes a provider "Simplex (local)" -> http://127.0.0.1:PORT/v1 with the
# kit's model as the default chat model, and after the Ready box asks:
# The kit now ships its own UI (above), so this is off unless you ask for it:
#   no   - never; also skips the 285 MB download   (default)
#   ask  - "Open Cherry Studio and start chatting now? [Y/n]"
#   yes  - open it without asking
CHERRY_AUTOSTART=no
# Tools the kit switches on for Cherry's default assistant (applied once, and
# again whenever you change these lines):
#   CHERRY_WEB_SEARCH   1 = the model gets web_search + web_fetch tools. Uses
#                       Cherry's stock keyless search provider (Exa MCP,
#                       https://mcp.exa.ai) - no API key needed; pick another
#                       provider in Cherry -> Settings -> Web Search.
#   CHERRY_MCP_SERVERS  Cherry builtin MCP servers to install + activate; the
#                       assistant runs MCP in "auto" mode (all active servers
#                       are offered to the model). Keyless choices:
#                       @cherry/fetch, @cherry/sequentialthinking,
#                       @cherry/python (sandboxed Pyodide), @cherry/browser.
#                       Empty = install none (assistant stays in manual mode).
CHERRY_WEB_SEARCH=1
CHERRY_MCP_SERVERS=@cherry/fetch,@cherry/sequentialthinking
# Pinned Cherry Studio release. The auto-configuration writes Cherry's own
# data store (v2.0.x layout); only bump after checking the schema still fits.
# CHERRY_VERSION=2.0.10
# Use a Cherry Studio you already installed instead of the kit's portable copy.
# The kit then only opens Cherry with its official provider-import link
# (cherrystudio://providers/api-keys); you confirm the popup and add the
# model id under the new provider yourself.
# CHERRY_EXE=C:\Users\you\AppData\Local\Programs\Cherry Studio\Cherry Studio.exe

# --- images (vision) -----------------------------------------
# The checkpoint carries Qwen3.8's vision tower (27 layers, 3-bit, ~0.3 GB).
#   auto - load it next to the text model so chat apps can attach pictures
#          (OpenAI image_url parts). If it does not fit under GPU_MEM_GB the
#          server says so and keeps running text-only.
#   off  - text only (a little more VRAM headroom)
VISION=auto
# Pictures are downscaled to at most this many pixels before encoding.
# 1 MP (1048576) ~ 1024 prompt tokens per image; raise for detail, lower for speed.
IMAGE_MAX_PIXELS=1048576

# --- cache / context -----------------------------------------
# Total KV cache size in TOKENS (must be a multiple of 256).
# This kit is for NVIDIA 16 GB VRAM. 199936 (~200k) boots under a 14.7 GB
# cap; native 262144 does not. On a 24 GB card you can set 262144.
CONTEXT_SIZE=199936

# KV cache format.
#   none   = fp16                       16 bits/elem   64 KB/token
#   8      = int8 (stock)               8.5 bits/elem  34 KB/token
#   8,4    = int8 K / int4 V (stock)    6.5 bits/elem  26 KB/token   <- validated recipe
#   4      = int4 (stock)               4.5 bits/elem  18 KB/token   (150k-context profile)
#   fp8    = FP8 E4M3, no scales        8 bits/elem    32 KB/token   (patched engine)
#   nvfp4  = E2M1 + E4M3 scale per 16   4.5 bits/elem  18 KB/token   (patched engine)
# Stock = the integer path of turboderp's v1.4.4 (Hadamard-rotated groups of 32,
# fp16 scale each). fp8 / nvfp4 come from the MiaAI-Lab exllamav3 fork and are
# hot-patched into the installed engine by start.bat / start.sh when selected
# (tools/patch_kv.py; Python + Triton only, no recompile; needs an Ada or
# Blackwell GPU, compute capability 8.9+). Same bytes as their integer twins -
# choose by quality, and measure it: run test_kv.bat (KL vs fp16, passkey,
# tok/s per format). Only the 16 full-attention layers hold KV.
CACHE_QUANT=8,4

# GPU memory budget in GB (autosplit + process cap).
# 16 GB NVIDIA cards typically have ~14.7 GB free after the driver — that
# is the validated budget. 24 GB card: 22. Leave unset to auto-detect
# (discrete: VRAM minus 2 GB; unified memory: free RAM minus 16 GB).
GPU_MEM_GB=14.7

# CPU second-tier cache size in GB. ACCEPTED BUT NOT YET ACTIVE —
# the spilling tier is planned, not implemented; the value is currently
# inert. Keep 0.
CPU_CACHE_GB=0

# --- notes ---------------------------------------------------
# Concurrency: the server generates ONE request at a time (batch-1
# speculative decoding). Concurrent requests queue automatically and
# are served in order; /health shows the busy flag.
#
# Sampling: requests may set temperature/top_p/top_k; server defaults
# follow Qwen3.8 recommendations (0.6 / 0.95 / 20).

# Parallel nvcc jobs for the one-time CUDA compile (default: 8 on >=8-core/>=32GB machines, else 4)
# MAX_JOBS=4

# =============================================================
# First run, packaging and desktop integration
# =============================================================

# Where the first run happens.
#   browser  (default) a page opens at the same address as the chat UI and
#            walks through the graphics-card check, the model choice, the
#            install and the download, with a progress bar and a live log.
#   console  the old question-and-answer flow in the launcher window. Use it
#            over SSH, or anywhere a browser cannot open.
SETUP=browser

# Prebuilt wheels, so the first run needs no C++ compiler or CUDA Toolkit.
# The wheels\ folder next to start.bat is always checked first; this is for
# wheels hosted somewhere pip can reach with --find-links (a GitHub Releases
# page, a file share, an internal index). Several may be listed, separated by
# spaces or commas. See wheels\README.md.
# WHEEL_INDEX=https://github.com/<you>/<repo>/releases/download/wheels/

# Notification-area icon with Open / Restart / View the log / Quit.
# Windows only; ignored everywhere else. TRAY=no turns it off.
TRAY=auto

# Start-menu and desktop shortcuts.
#   auto  (default) created once, the first time Simplex starts properly
#   yes   make sure they exist on every launch
#   no    never create them
SHORTCUTS=auto
