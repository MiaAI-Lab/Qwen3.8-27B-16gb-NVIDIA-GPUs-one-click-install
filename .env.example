# ============================================================
#  exllamav3 OpenAI-compatible server — configuration
#  (read by ./linux/start.sh and windows\start.bat; restart the server after changes)
# ============================================================

# --- engine install (first run only) ---------------------------
# On first launch linux/start.sh creates .venv and installs the engine:
# inside the engine repo it builds from the local checkout; anywhere
# else (deployment kit) it pip-installs from EXL3_REPO.
# Normally none of this is needed: the engine's own GitHub release publishes a
# wheel per (CUDA line x torch version x Python), and the launcher installs the
# one that matches this venv - a ~100 MB download, no compiler. PyPI is what
# has no 1.4.4 (it jumps 1.4.2 -> 1.4.5); the release does.
# The source build below is the fallback, used when no wheel fits: an unbuilt
# CUDA line, aarch64 (GB10/Spark), or a torch newer than the release.
# EXL3_REPO forces the source build from a git+https:// URL or a path that
# exists on THIS machine. Do not copy a Linux/Spark path onto Windows.
# EXL3_REPO=git+https://github.com/turboderp-org/exllamav3.git@v1.4.4
# TORCH_INDEX_URL overrides the PyTorch wheel index. The default is cu128,
# which is deliberate: the engine release builds for cu128 and cu132 only, so
# torch from any other line means there is no prebuilt engine and the kit
# compiles. cu128 covers Blackwell and needs driver 570+. GB10/Spark uses cu130
# and compiles either way.
# The torch VERSION is chosen too, not just the index - the newest torch is not
# always one the engine has a wheel for. tools/wheels.py reads that from the
# same table it uses to pick the wheel, so the two cannot drift; run
#   .venv\Scripts\python.exe tools\wheels.py
# to see what it resolves to. When the engine starts publishing for a newer
# torch, update ENGINE_WHEELS in tools/wheels.py and both follow.
# TORCH_CUDA_ARCH_LIST pins the extension build arch (GB10: "12.0;12.1";
# x86 auto-detects from the GPU and needs nothing).
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# TORCH_CUDA_ARCH_LIST=12.0;12.1

# --- profile (GPU-aware) --------------------------------------
# On the first start (no PROFILE line) or with PROFILE=ask, windows\start.bat / linux/start.sh
# read the GPU's VRAM and offer profiles - best quality vs longest context -
# e.g. 16 GB: 2.5 bpw @ 176k+images (the default), 3.0 bpw @ 118k+images,
#      3.5 bpw @ 78k, 2.0 bpw @ 229k+images;
# 24 GB and up: 4.0 bpw @ 262k+images (the default), 5.0 bpw @ 176k+images,
#      6.0 bpw @ 82k
# (2.5 bpw's 16 GB figures are measured, not computed - see README). The KV cache
# is always int4 for profiles (measured ~free in quality; any supported GPU).
# The choice is written below (MODEL_DIR, HF_*, CONTEXT_SIZE, CACHE_QUANT,
# GPU_MEM_GB, VISION, MODEL_ID). Re-pick any time:  windows\start.bat profile
# PROFILE=ask

# --- models -------------------------------------------------
# Target model directory (EXL3 quant). Relative to this directory,
# or an absolute path. Downloaded from the Hub automatically if missing.
MODEL_DIR=models/Qwen3.8-27B-EXL3-2.0bpw
# Model id reported by /v1/models (default: the MODEL_DIR folder name, lower-cased).
# MODEL_ID=qwen3.8-27b-exl3-2.0bpw

# --- Speculative decoding ------------------------------------
# DRAFT selects the drafting method:
#   mtp     - MTP head inside the main checkpoint (~50 MB): no download.
#             Default, and what the 16 GB recipe was measured with.
#   none    - no drafting: slower per token, slightly less memory.
# DRAFT=mtp

# --- Hub downloads -------------------------------------------
# Missing MODEL_DIR is fetched automatically on start.
# Set HF_TOKEN=<a token with read access> here, or run `hf auth login`
# once. Override the repo id to use a mirror of your own.
# HF_TOKEN=hf_xxx
# HF_TARGET_REPO=Mia-AiLab/Qwen3.8-27B-EXL3-2.0bpw
# HF_REVISION picks a branch/tag of that repo (e.g. turboderp's 3.00bpw branch);
# pair it with a fresh MODEL_DIR so the 2.0 bpw weights are not overwritten.
# HF_TARGET_REPO=turboderp/Qwen3.8-27B-exl3
# HF_REVISION=3.00bpw
# MODEL_DIR=models/Qwen3.8-27B-EXL3-3.0bpw

# --- HTTP ----------------------------------------------------
PORT=8888
# Bind address. 0.0.0.0 = LAN-wide (no auth!), 127.0.0.1 = local only.
HOST=0.0.0.0

# --- the harness (what you actually talk to) ------------------
# The server speaks OpenAI on /v1 and serves one small page at
# http://127.0.0.1:PORT/ saying where things are. The chat and agent front end
# is the DeepSeek Harness (`dsh`) - DeepSeek's open-source agent harness, MIT,
# https://github.com/deepseek-ai/deepseek-harness - started as a second process
# once the model is loaded, on its own port.
#
# Nothing of it is vendored here. It is a Node application, so the launcher
# runs it with `npx` and npm caches it after the first run; the only thing you
# have to install is Node (https://nodejs.org/, the LTS build).
#
# Before it starts, tools/dsh.py asks the running server what it is - id,
# context window, whether images loaded, which reasoning levels the chat
# template acts on - and writes .dsh/settings.yaml from the answer. So the
# harness is configured from what actually loaded, not from what this file
# hoped for, and a model switch reaches it without anyone editing anything.
#
#   browser - start it and open it once the server is Ready   (default)
#   server  - start it, open nothing (you open the URL yourself)
#   no      - do not start it at all; /v1 still serves every other client
UI=browser
# The port the harness listens on. Do not name this DSH_PORT: current dsh
# treats DSH_PORT in a .env file as fatal ("export it instead") and the chat
# UI never binds, even though /v1 is already up. A leftover harness still
# holding the port is cleared by windows\stop.bat / ./linux/stop.sh.
SIMPLEX_HARNESS_PORT=3080
# The npm version to run. dsh is in developer preview and breaks compatibility
# between releases, so this is pinned; `latest` follows the newest instead.
# A version npm does not have falls back to `latest` with a line saying so.
DSH_VERSION=0.1.3-alpha.2
#
# Everything else about the harness is its own: the workspace folder it may
# touch, the approval policy, its tools, MCP servers and plugins are all set
# inside it, or in .dsh/settings.yaml next to the route this kit writes. That
# file is yours the moment you edit it - the launcher compares it against the
# copy it last generated and stops generating once the two differ. Delete it
# to get a fresh one.
#
# The harness binds loopback only, and refuses to bind 0.0.0.0 at all: its
# agent runs commands on this PC and there is no login. To reach it from a
# phone, put a proxy in front of it rather than opening the port -
#   tailscale serve --bg 3080
# and note that HOST=0.0.0.0 above already exposes /v1 (the API, not the
# harness) to whatever network you are on. Set HOST=127.0.0.1 if that network
# is not yours.

# --- what the harness is told about the model -----------------
# Key sent to the model server. It ignores it, but the harness refuses to make
# a request on a route with no credential at all, so one is always sent.
# API_KEY=local
# Ceiling on one answer, written into the harness's model entry. Not an
# allocation: too low and a tool call writing a file is cut off mid-JSON.
# MAX_TOKENS=65536

# --- chat app: Cherry Studio (Windows, windows\start.bat only) --------
# Cherry Studio is an open-source desktop chat app (streaming, tools, MCP):
# https://github.com/CherryHQ/cherry-studio . windows\start.bat downloads the pinned
# Windows portable build once into apps/cherry-studio/ (~285 MB, gitignored),
# writes a provider "Simplex (local)" -> http://127.0.0.1:PORT/v1 with the
# kit's model as the default chat model, and after the Ready box asks:
# The harness above is what the kit starts, so this is off unless you ask:
#   no   - never; also skips the 285 MB download   (default)
#   ask  - "Open Cherry Studio and start chatting now? [Y/n]"
#   yes  - open it without asking
CHERRY_AUTOSTART=no
# Tools the kit switches on for Cherry's default assistant (applied once, and
# again whenever you change these lines):
#   CHERRY_WEB_SEARCH   1 = the model gets web_search + web_fetch tools. Uses
#                       Cherry's stock keyless search provider (Exa MCP,
#                       https://mcp.exa.ai) - no API key needed; pick another
#                       provider in Cherry -> Settings -> Web Search.
#   CHERRY_MCP_SERVERS  Cherry builtin MCP servers to install + activate; the
#                       assistant runs MCP in "auto" mode (all active servers
#                       are offered to the model). Keyless choices:
#                       @cherry/fetch, @cherry/sequentialthinking,
#                       @cherry/python (sandboxed Pyodide), @cherry/browser.
#                       Empty = install none (assistant stays in manual mode).
CHERRY_WEB_SEARCH=1
CHERRY_MCP_SERVERS=@cherry/fetch,@cherry/sequentialthinking
# Pinned Cherry Studio release. The auto-configuration writes Cherry's own
# data store (v2.0.x layout); only bump after checking the schema still fits.
# CHERRY_VERSION=2.0.10
# Use a Cherry Studio you already installed instead of the kit's portable copy.
# The kit then only opens Cherry with its official provider-import link
# (cherrystudio://providers/api-keys); you confirm the popup and add the
# model id under the new provider yourself.
# CHERRY_EXE=C:\Users\you\AppData\Local\Programs\Cherry Studio\Cherry Studio.exe

# --- images (vision) -----------------------------------------
# The checkpoint carries Qwen3.8's vision tower (27 layers, 3-bit, ~0.3 GB).
#   auto - load it next to the text model so chat apps can attach pictures
#          (OpenAI image_url parts). If it does not fit under GPU_MEM_GB the
#          server says so and keeps running text-only.
#   off  - text only (a little more VRAM headroom)
VISION=auto
# Pictures are downscaled to at most this many pixels before encoding.
# 1 MP (1048576) ~ 1024 prompt tokens per image; raise for detail, lower for speed.
IMAGE_MAX_PIXELS=1048576

# --- cache / context -----------------------------------------
# Total KV cache size in TOKENS (must be a multiple of 256).
# This kit is for NVIDIA 16 GB VRAM. 199936 (~200k) boots under a 14.7 GB
# cap; native 262144 does not. On a 24 GB card you can set 262144.
CONTEXT_SIZE=199936

# KV cache format - the integer path of turboderp's v1.4.4 (Hadamard-rotated
# groups of 32, fp16 scale each). No GPU-generation requirement: every card
# this kit supports can run all of them.
#   none   = fp16                  16 bits/elem   64 KB/token
#   8      = int8                  8.5 bits/elem  34 KB/token
#   8,4    = int8 K / int4 V       6.5 bits/elem  26 KB/token   <- validated recipe
#   4      = int4                  4.5 bits/elem  18 KB/token   (150k-context profile)
# int4's KL against an fp16 cache is ~300x smaller than the 2.0 bpw weight
# quantization's own, i.e. free. Only the 16 full-attention layers hold KV.
CACHE_QUANT=8,4

# GPU memory budget in GB (autosplit + process cap).
# 16 GB NVIDIA cards typically have ~14.7 GB free after the driver — that
# is the validated budget. 24 GB card: 22. Leave unset to auto-detect
# (discrete: VRAM minus 2 GB; unified memory: free RAM minus 16 GB).
GPU_MEM_GB=14.7

# CPU second-tier cache size in GB. ACCEPTED BUT NOT YET ACTIVE —
# the spilling tier is planned, not implemented; the value is currently
# inert. Keep 0.
CPU_CACHE_GB=0

# --- notes ---------------------------------------------------
# Concurrency: the server generates ONE request at a time (batch-1
# speculative decoding). Concurrent requests queue automatically and
# are served in order; /health shows the busy flag.
#
# Sampling: requests may set temperature/top_p/top_k; server defaults
# follow Qwen3.8 recommendations (0.6 / 0.95 / 20).

# Parallel nvcc jobs for the one-time CUDA compile (default: 8 on >=8-core/>=32GB machines, else 4)
# MAX_JOBS=4

# =============================================================
# First run, packaging and desktop integration
# =============================================================

# Where the first run happens.
#   browser  (default) a page opens at the server's own address and walks
#            through the graphics-card check, the model choice, the install
#            and the download, with a progress bar and a live log. When it
#            finishes, that address becomes the page pointing at the harness.
#   console  the old question-and-answer flow in the launcher window. Use it
#            over SSH, or anywhere a browser cannot open.
SETUP=browser

# Prebuilt wheels, so the first run needs no C++ compiler or CUDA Toolkit.
# The wheels\ folder next to windows\start.bat is always checked first; this is for
# wheels hosted somewhere pip can reach with --find-links (a GitHub Releases
# page, a file share, an internal index). Several may be listed, separated by
# spaces or commas. See wheels\README.md.
# WHEEL_INDEX=https://github.com/<you>/<repo>/releases/download/wheels/

# Notification-area icon with Open / Restart / View the log / Quit.
# Windows only; ignored everywhere else. TRAY=no turns it off.
TRAY=auto

# Start-menu and desktop shortcuts.
#   auto  (default) created once, the first time Simplex starts properly
#   yes   make sure they exist on every launch
#   no    never create them
SHORTCUTS=auto
